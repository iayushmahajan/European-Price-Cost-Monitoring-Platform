# Copy to .env. Generate distinct URL-safe passwords, e.g. openssl rand -hex 24.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=
AI_PROVIDER=foundry_local
AI_MODEL=phi-4-mini
# For Groq, set AI_PROVIDER=groq, AI_MODEL=openai/gpt-oss-20b,
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions and AI_API_KEY.
AI_API_KEY=
# From `foundry server status`. Docker Desktop: replace localhost with host.docker.internal.
AI_API_URL=
AI_REQUEST_TIMEOUT_SECONDS=120
MAX_SQL_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_BYTES=200000
ANALYSIS_MAX_ROWS=30
ANALYSIS_MAX_BYTES=12000
QUERY_HISTORY_LIMIT=20
APP_ENV=development
API_ROOT_PATH=
LOG_LEVEL=INFO
# For non-Docker development only; replace passwords and provision roles first.
DATABASE_URL=postgresql://analytics_app:CHANGE_ME@localhost:5432/analytics_db
ANALYTICS_DATABASE_URL=postgresql://analytics_reader:CHANGE_ME@localhost:5432/analytics_db
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api

# Optional independent price/cost synchronization worker (Compose profile price-cost-sync).
SYNC_FUEL_INTERVAL_SECONDS=604800
SYNC_HICP_INTERVAL_SECONDS=86400
SYNC_ECB_INTERVAL_SECONDS=21600
SYNC_BACKFILL_INTERVAL_DAYS=30
SYNC_OVERLAP_DAYS=400
# Approved subsets can be configured; defaults cover all seeded countries/categories/units/currencies.
# SYNC_HICP_GEOS=EU27_2020,DE
# SYNC_HICP_CATEGORIES=TOTAL,CP01
# SYNC_HICP_UNITS=I25,RCH_M,RCH_A
# SYNC_ECB_CURRENCIES=USD,GBP,CHF
# For non-Docker CLI use a writable persistent directory:
# PRICE_COST_ARTIFACT_ROOT=/absolute/path/to/price-cost
